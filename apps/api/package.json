{
  "name": "@mycogni/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@mycogni/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@mycogni/config": "workspace:*",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "typescript": "6.0.3"
  }
}
